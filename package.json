{
  "name": "@sylvieshare/share-ui",
  "version": "0.2.1",
  "description": "Shared Vue 3 design tokens, UI primitives and headless interactions for SylvieShare applications.",
  "type": "module",
  "main": "./dist/share-ui.js",
  "module": "./dist/share-ui.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/share-ui.js"
    },
    "./styles.css": "./dist/share-ui.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/index.d.ts",
    "README.md",
    "docs"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "npm run check:colors && vite build",
    "test": "vitest run",
    "check:colors": "node scripts/check-colors.mjs",
    "check": "npm test && npm run build",
    "prepack": "npm run check"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.0.0",
    "vue": "^3.5.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
